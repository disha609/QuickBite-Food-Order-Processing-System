{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",   
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
  "auth-service/src/**/*",
  "profile-service/src/**/*",
  "menu-service/src/**/*",
  "order-service/src/**/*",
  "common/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
